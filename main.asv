close all;

figure;
plot(t, vout);
hold on;
plot(t, vin);
f_c = 1000;
omega_x = 2 * pi * f_c;
s = tf('s') / omega_x;

n = 8;
R = (1/n)^(1/n);
theta_k = [];

Q_p = 1;

for k = 1:n
    theta_k(k) = ((2*k-1)*pi)/(2*n);
end

p_k = (- R * sin(theta_k)) + (1i * R * cos(theta_k));

for k = 1:n
    Q_p = Q_p * (s - p_k(k));
end

K = prod(p_k);

H_p = K / Q_p;

[num, den] = tfdata[H_p, 'v'];

num = real(num);
den = real(den);

H_p_norm = tf[]

figure;
bode(H_p);


function total_SE = calcMSE(x, y)

  SE =  (x - y).^2;
  total_SE = sum(SE);
  
end