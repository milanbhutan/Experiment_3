data = load('iodata.mat');

Ts = 10000

%Run
Cont_Filter;

G_z_cheby_impinv = ImpInv(H_LP);

G_z_b4th_bilinear = Bilinear(H_b4th_lp_norm, Ts);
G_z_b8th_bilinear = Bilinear(H_b8th_lp_norm, Ts);

% Extract its numerator and denominator
[numZ, denZ] = tfdata(G_z_cheby_impinv, 'v');


t_data    = data.t(:);
vin_data  = data.vin(:);
vout_data = data.vout(:);

%% Transfer-function values
zeta = 0.133;
wn   = 12.5;
K    = 6.25;

numerator   = K * wn^2;
denominator = [1, 2*zeta*wn, wn^2];

G = tf(numerator, denominator);

%% Simulate the output
t_sim = t_data - t_data(1);

% Step occurs at t = 0 in the displayed measured data
step_input = double(t_data >= 0);

vout_test = lsim(G, step_input, t_sim);
vout_data_filtered = filter(numZ, denZ, vout_data);
%% Plot measured and simulated signals
figure

plot(t_data, vin_data, 'LineWidth', 1.5)
hold on
plot(t_data, vout_data, 'LineWidth', 1.5)
plot(t_data, vout_data_filtered, 'LineWidth', 1.5)
plot(t_data, vout_test, '--', 'LineWidth', 2)
hold off

grid on
xlabel('Time (s)')
ylabel('Voltage (V)')
legend('Measured Vin', 'Measured Vout', ...
       'Simulated Vout', 'Location', 'best')
title('Measured and Simulated Output')

%% Total squared error
SSE = totalSquaredError(vout_data, vout_test);

fprintf('Total squared error: %.6f\n', SSE);
